    <nav class="week-selector-bar" role="tablist" aria-label="Selecionar semana">
        <button type="button" class="week-tab-btn" id="btn-tab-2026-09-28" role="tab" aria-selected="false" aria-controls="week-panel-2026-09-28" data-action="show-week" data-week-id="2026-09-28">[...]</button>
        <button type="button" class="week-tab-btn" id="btn-tab-2026-10-05" role="tab" aria-selected="false" aria-controls="week-panel-2026-10-05" data-action="show-week" data-week-id="2026-10-05">[...]</button>
