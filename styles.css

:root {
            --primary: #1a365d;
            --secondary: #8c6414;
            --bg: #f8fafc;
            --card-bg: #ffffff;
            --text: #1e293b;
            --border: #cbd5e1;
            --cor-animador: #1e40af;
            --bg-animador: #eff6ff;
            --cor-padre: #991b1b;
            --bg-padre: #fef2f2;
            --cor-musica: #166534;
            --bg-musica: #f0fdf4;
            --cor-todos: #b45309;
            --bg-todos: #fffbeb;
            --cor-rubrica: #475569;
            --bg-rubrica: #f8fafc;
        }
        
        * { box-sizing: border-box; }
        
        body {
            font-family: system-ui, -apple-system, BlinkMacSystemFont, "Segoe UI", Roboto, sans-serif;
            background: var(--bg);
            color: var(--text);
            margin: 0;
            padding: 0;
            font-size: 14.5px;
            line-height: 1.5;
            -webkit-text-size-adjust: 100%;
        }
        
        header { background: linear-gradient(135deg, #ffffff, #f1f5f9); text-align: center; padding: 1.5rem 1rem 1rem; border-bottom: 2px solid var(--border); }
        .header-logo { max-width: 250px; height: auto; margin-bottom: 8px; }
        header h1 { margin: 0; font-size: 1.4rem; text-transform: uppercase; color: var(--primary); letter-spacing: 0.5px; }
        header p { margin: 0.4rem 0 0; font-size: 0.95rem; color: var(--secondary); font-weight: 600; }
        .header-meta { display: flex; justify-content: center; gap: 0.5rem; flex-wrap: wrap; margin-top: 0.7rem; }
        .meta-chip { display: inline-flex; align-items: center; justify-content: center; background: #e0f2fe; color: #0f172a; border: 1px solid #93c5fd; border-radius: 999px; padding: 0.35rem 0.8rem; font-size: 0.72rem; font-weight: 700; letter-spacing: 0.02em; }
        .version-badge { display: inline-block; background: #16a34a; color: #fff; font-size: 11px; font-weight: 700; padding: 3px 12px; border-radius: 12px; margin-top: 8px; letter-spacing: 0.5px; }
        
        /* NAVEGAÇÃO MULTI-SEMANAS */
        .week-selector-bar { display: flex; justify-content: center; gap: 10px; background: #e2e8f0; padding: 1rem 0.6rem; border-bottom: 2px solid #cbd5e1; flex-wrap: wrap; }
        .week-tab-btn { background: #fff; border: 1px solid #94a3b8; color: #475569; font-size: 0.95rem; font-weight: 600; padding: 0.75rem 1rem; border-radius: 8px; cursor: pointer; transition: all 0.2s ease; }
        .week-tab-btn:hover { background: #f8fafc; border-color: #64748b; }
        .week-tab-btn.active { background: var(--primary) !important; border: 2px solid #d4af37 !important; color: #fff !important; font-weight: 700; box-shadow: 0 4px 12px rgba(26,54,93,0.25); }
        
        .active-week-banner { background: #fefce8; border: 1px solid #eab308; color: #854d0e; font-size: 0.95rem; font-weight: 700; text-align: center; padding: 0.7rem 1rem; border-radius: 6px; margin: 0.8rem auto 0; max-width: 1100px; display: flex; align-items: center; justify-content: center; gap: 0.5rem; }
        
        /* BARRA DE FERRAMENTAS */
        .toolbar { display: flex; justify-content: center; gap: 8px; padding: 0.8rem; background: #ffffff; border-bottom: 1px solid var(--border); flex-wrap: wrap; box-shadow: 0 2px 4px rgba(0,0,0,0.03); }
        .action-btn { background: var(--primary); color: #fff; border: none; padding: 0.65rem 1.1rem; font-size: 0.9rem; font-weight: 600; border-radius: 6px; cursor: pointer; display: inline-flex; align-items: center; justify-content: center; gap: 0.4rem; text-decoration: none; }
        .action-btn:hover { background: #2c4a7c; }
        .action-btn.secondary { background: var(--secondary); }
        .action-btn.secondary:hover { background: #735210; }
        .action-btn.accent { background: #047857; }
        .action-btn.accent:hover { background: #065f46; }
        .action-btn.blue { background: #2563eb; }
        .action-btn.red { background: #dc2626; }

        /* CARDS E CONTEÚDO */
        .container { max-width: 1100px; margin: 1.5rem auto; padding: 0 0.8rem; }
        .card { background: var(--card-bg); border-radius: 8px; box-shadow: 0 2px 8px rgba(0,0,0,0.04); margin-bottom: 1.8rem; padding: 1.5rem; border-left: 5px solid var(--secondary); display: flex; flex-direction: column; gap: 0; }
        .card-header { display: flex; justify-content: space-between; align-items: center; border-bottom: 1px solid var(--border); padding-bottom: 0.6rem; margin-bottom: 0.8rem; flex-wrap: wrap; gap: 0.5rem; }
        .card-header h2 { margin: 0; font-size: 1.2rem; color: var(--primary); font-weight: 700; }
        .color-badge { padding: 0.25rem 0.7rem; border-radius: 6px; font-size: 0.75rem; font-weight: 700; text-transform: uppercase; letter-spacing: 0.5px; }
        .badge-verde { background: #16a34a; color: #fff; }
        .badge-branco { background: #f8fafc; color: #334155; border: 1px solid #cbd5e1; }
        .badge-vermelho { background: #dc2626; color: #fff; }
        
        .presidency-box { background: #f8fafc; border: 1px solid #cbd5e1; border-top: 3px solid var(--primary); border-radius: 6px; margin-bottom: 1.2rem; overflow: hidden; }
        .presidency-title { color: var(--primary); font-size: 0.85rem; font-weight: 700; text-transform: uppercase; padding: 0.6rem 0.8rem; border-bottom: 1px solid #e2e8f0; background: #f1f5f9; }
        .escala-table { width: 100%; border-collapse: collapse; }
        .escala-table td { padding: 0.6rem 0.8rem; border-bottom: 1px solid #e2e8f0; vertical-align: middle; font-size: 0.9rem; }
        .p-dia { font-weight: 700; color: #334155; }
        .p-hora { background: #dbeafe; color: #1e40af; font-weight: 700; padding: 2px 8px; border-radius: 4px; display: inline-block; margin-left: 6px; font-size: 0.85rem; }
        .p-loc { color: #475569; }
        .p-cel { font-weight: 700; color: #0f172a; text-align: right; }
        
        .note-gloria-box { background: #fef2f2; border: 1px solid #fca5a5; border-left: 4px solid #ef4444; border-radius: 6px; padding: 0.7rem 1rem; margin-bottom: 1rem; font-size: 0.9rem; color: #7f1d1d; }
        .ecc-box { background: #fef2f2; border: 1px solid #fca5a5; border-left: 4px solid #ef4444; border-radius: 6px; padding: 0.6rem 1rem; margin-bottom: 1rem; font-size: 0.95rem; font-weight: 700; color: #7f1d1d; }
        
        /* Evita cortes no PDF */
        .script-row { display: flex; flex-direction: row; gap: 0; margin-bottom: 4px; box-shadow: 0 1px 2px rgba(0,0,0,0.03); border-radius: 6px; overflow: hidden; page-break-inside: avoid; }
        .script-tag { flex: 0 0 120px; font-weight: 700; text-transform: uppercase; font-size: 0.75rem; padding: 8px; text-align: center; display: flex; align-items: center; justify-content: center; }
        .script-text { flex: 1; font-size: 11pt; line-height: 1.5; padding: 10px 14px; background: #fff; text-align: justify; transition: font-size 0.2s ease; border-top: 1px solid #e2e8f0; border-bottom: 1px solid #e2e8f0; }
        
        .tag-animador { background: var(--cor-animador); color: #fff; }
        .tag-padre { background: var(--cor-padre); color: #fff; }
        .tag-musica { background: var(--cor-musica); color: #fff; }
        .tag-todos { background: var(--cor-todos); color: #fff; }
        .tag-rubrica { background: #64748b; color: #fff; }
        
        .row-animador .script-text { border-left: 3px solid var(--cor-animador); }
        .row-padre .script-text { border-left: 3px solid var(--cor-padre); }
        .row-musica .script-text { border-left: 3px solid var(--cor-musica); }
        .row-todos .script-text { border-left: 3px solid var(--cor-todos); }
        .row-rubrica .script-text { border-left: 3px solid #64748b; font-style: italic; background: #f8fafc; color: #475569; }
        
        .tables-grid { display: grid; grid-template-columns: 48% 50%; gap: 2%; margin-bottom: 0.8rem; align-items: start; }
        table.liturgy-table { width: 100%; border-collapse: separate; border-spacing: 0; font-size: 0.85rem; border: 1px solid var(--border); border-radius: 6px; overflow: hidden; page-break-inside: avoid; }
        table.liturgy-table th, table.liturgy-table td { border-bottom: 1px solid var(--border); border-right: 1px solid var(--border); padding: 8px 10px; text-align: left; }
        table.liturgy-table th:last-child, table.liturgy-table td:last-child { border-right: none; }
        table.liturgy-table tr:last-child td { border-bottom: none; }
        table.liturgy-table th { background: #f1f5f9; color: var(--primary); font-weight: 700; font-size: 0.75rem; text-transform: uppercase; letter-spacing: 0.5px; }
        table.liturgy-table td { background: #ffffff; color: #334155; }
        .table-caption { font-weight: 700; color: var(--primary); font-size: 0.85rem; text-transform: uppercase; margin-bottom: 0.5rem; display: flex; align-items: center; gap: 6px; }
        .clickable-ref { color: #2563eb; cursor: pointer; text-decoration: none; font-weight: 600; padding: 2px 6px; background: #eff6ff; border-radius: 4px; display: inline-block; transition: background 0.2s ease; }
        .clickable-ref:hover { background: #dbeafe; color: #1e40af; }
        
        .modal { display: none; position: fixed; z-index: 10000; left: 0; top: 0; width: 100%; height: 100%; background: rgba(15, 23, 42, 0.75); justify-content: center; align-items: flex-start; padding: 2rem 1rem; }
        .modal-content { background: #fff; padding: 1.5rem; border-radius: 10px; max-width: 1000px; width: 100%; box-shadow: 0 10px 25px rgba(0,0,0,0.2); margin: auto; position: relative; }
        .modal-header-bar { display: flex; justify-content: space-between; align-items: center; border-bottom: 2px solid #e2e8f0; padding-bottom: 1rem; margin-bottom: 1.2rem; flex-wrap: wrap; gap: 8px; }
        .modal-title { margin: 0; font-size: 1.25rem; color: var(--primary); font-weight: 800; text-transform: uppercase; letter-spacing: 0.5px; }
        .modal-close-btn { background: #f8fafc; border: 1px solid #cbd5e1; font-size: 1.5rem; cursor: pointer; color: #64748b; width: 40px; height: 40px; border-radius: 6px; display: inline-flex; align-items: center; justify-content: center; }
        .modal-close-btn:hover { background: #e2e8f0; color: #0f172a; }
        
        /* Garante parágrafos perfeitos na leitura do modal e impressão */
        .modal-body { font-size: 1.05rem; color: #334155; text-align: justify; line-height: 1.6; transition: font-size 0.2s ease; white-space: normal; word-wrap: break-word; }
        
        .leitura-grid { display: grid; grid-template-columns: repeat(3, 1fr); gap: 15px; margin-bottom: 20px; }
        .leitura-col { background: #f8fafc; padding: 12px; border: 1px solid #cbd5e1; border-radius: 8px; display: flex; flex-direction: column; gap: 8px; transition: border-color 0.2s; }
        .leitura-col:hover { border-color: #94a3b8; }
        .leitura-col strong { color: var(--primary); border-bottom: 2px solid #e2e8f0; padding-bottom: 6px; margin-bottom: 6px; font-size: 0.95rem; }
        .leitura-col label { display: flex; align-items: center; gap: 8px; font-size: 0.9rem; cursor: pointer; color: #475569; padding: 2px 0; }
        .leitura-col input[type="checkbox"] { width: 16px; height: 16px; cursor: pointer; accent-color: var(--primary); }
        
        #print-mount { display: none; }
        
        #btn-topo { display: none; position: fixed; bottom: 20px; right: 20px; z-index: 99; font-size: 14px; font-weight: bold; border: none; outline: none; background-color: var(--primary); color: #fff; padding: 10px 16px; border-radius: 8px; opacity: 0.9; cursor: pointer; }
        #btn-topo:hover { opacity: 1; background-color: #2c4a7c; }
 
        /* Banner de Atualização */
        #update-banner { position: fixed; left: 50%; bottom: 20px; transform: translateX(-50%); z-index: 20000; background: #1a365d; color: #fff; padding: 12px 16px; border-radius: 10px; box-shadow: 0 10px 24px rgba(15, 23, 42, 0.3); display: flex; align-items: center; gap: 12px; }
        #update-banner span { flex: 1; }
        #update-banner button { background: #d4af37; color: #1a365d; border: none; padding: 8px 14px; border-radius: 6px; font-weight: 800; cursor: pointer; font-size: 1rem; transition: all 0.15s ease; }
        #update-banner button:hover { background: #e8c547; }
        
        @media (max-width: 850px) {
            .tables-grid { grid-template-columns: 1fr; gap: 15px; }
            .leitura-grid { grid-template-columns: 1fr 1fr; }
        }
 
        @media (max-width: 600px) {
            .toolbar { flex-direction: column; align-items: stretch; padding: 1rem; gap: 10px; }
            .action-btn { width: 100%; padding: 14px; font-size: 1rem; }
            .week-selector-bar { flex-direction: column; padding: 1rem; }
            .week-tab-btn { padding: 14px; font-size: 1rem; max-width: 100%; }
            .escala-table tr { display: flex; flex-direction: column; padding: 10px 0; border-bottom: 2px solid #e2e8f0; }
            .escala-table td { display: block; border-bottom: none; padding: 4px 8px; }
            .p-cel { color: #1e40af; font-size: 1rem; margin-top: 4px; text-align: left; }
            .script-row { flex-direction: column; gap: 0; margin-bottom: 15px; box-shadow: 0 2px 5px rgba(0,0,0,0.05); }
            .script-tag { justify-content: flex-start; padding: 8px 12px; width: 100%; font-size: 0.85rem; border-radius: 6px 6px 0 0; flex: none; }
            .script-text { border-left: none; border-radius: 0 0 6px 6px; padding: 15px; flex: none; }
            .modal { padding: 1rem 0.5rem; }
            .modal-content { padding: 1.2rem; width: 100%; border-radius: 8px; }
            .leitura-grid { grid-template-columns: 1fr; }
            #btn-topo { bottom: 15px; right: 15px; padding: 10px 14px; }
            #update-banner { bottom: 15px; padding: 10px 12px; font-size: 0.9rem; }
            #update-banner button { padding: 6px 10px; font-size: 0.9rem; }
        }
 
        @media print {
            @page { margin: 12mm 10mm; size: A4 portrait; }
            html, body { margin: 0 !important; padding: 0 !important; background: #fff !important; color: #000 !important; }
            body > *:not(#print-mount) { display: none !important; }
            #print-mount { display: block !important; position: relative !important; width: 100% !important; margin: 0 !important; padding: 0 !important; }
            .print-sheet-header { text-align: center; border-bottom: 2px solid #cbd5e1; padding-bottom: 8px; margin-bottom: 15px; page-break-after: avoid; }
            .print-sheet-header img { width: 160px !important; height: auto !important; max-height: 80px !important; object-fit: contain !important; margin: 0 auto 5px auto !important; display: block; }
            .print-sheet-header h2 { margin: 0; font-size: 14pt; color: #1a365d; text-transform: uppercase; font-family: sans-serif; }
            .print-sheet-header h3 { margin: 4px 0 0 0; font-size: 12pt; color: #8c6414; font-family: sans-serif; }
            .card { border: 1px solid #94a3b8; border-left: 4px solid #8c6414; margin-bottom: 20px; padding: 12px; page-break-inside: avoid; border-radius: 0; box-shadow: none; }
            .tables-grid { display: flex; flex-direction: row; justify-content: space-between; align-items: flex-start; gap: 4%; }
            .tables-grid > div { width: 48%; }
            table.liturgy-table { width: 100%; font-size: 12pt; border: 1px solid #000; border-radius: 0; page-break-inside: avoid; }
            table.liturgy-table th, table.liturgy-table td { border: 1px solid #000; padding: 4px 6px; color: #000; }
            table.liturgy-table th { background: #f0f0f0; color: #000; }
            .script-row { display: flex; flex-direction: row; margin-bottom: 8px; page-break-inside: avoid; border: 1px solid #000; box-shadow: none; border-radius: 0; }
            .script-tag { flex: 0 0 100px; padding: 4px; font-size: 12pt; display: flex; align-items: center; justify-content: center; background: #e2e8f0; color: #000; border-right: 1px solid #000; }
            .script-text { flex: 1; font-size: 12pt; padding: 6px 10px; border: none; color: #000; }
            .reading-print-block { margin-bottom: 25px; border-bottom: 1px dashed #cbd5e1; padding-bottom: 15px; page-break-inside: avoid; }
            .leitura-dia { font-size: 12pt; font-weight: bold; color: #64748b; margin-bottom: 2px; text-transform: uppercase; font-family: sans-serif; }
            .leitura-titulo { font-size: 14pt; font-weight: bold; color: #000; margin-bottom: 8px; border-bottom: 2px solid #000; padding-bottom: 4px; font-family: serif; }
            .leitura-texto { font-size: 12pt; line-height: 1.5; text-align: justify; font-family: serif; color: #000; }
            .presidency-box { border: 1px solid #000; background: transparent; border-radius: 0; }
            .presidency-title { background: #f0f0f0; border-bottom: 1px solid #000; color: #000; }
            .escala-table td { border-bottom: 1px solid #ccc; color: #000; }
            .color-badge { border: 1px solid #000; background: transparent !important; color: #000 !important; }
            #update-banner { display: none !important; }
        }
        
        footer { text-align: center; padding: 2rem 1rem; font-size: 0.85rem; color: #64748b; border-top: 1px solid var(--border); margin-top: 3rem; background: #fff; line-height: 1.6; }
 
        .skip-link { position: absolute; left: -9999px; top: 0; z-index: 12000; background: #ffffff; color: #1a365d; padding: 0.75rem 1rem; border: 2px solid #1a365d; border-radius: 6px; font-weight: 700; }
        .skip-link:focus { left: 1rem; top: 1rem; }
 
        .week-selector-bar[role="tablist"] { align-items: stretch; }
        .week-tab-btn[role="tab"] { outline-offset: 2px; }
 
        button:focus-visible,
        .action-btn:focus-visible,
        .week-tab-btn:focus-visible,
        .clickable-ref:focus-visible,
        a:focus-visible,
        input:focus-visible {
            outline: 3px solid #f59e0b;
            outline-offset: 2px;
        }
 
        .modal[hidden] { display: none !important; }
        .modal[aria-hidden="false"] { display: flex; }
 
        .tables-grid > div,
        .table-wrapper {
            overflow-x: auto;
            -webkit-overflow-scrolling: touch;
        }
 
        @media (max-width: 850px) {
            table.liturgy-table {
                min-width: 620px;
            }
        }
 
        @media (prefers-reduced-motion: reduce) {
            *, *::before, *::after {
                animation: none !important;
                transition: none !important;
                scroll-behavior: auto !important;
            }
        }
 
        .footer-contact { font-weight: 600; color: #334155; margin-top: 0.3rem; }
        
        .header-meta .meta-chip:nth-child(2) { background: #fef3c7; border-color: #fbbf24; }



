    <div class="active-week-banner" id="active-week-banner">
        <span>👀</span>
        <span id="active-week-text">EXIBINDO NA TELA...</span>
    </div>
    
    <div class="toolbar" aria-label="Ações principais">
        <button type="button" class="action-btn" data-action="open-active-programacao">🗓️ Programação</button>
        <button type="button" class="action-btn" data-action="open-active-roteiro">📖 Roteiro</button>
        <button type="button" class="action-btn" data-action="open-active-preces">🙏 Preces</button>
        <button type="button" class="action-btn secondary" data-action="open-active-leituras">📖 Leituras e Antífonas</button>
        <button type="button" class="action-btn accent" data-action="open-active-reflexoes">💡 Reflexões</button>
        <button type="button" class="action-btn secondary" data-action="open-adoracao-solene" id="btn-adoracao-solene" style="display:none;">🙏 Adoração Solene</button>
