<body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    
    <header>
        <img src="Selo Auxiliadora 60 anos_Ano 3.png" alt="Selo 60 Anos" class="header-logo" id="header-logo">
        <h1>Paróquia Nossa Senhora Auxiliadora</h1>
        <p id="header-subtitle">Carregando programação...</p>
        <div class="header-meta" id="app-meta" aria-live="polite">
            <span class="meta-chip" id="app-version">Versão v1.0.0</span>
